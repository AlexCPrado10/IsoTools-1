# API
PORT=3000
LOG_LEVEL=info

# Shared IsoTools API connection (set a different key for each tool service)
ISOTOOLS_API_URL=https://tools.orcalabs.mx/api/v1
ISOTOOLS_API_KEY_CALCULATE_CONTROL_CHARTS=
ISOTOOLS_API_KEY_DETECT_BUSINESS_ANOMALIES=
ISOTOOLS_API_KEY_GENERATE_KPIS=

# Database (used when running locally without Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=industrial
DB_PASSWORD=industrial
DB_NAME=industrial_events
DATABASE_URL=postgresql://industrial:industrial@localhost:5432/industrial_events

# When using Docker Compose the service name `db` is used as host.
